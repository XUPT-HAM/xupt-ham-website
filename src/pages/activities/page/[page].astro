---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ActivityList from '../../../components/ActivityList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const pageSize = 5;
	const all = (await getCollection('activities')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
	);
	const totalPages = Math.max(1, Math.ceil(all.length / pageSize));
	const paths = [];
	for (let p = 2; p <= totalPages; p++) {
		const start = (p - 1) * pageSize;
		paths.push({
			params: { page: String(p) },
			props: {
				posts: all.slice(start, start + pageSize),
				currentPage: p,
				lastPage: totalPages,
				prevUrl: p === 2 ? '/activities/' : `/activities/page/${p - 1}`,
				nextUrl: p < totalPages ? `/activities/page/${p + 1}` : undefined,
			},
		});
	}
	return paths;
}

const { posts, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---

<StarlightPage
	frontmatter={{ title: `近期活动（第 ${currentPage} 页）`, description: '五九电波社近期活动与通联日志', tableOfContents: false }}
	hasSidebar={false}
>
	<ActivityList
		posts={posts}
		currentPage={currentPage}
		lastPage={lastPage}
		prevUrl={prevUrl}
		nextUrl={nextUrl}
	/>
</StarlightPage>
