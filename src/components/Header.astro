---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';

// 根据当前语言决定链接前缀：默认语言（根路径）为空，英文为 /en
const t = Astro.locals.t ?? ((key: string) => key);
const base = Astro.currentLocale === 'en' ? '/en' : '';
const links = [
	{ href: `${base}/`, label: t('nav.home') },
	{ href: `${base}/activities/`, label: t('nav.activities') },
	{ href: `${base}/members/`, label: t('nav.members') },
	{ href: `${base}/about/`, label: t('nav.about') },
	{ href: `${base}/history/`, label: t('nav.history') },
	{ href: `${base}/contact/`, label: t('nav.contact') },
	{ href: `${base}/links/`, label: t('nav.links') },
	{ href: `${base}/start/01-about-wiki/`, label: t('nav.knowledge') },
];
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="sl-flex site-nav" aria-label="Main">
		{
			links.map((link) => (
				<a href={link.href} aria-label={link.label}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="right-group">
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
			flex-wrap: wrap;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			flex-shrink: 0;
		}

		.site-nav {
			flex: 1 1 auto;
			gap: 1.25rem;
			align-items: center;
			justify-content: center;
		}

		.site-nav a {
			color: var(--sl-color-gray-1);
			text-decoration: none;
			font-weight: 600;
			white-space: nowrap;
		}

		.site-nav a:hover {
			color: var(--sl-color-accent-high);
		}

		.right-group {
			gap: 1rem;
			align-items: center;
			display: flex;
			flex-shrink: 0;
		}

		@media (max-width: 50rem) {
			.header {
				padding: 0.5rem 0;
				row-gap: 0.5rem;
			}

			.site-nav {
				order: 3;
				width: 100%;
				justify-content: flex-start;
				overflow-x: auto;
				overflow-y: hidden;
				-webkit-overflow-scrolling: touch;
				scrollbar-width: none; /* Firefox */
				padding: 0.25rem 0;
				gap: 1rem;
			}

			.site-nav::-webkit-scrollbar {
				display: none; /* Chrome, Safari, Edge */
			}

			.site-nav a {
				font-size: var(--sl-text-sm);
				padding: 0.2rem 0.4rem;
				border-radius: 0.25rem;
				flex-shrink: 0;
			}
		}
	}
</style>
